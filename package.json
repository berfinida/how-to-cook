{
  "name": "how-to-cook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run test/repository.integration.test.ts",
    "audit:lighthouse": "lighthouse http://127.0.0.1:3000/tr --quiet --chrome-flags='--headless --no-sandbox' --output=json --output-path=test-results/lighthouse-tr.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "lucide-react": "0.545.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/react": "16.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "27.0.1",
    "lighthouse": "^13.5.0",
    "postcss": "8.5.6",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.3"
  }
}
