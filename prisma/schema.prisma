generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum RecipeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

enum Locale {
  TR
  EN
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  role         Role         @default(USER)
  image        String?
  recipes      Recipe[]
  comments     Comment[]
  ratings      Rating[]
  favorites    Favorite[]
  collections  Collection[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Recipe {
  id                String             @id @default(cuid())
  slug              String             @unique
  authorId          String
  author            User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status            RecipeStatus       @default(DRAFT)
  servings          Int
  prepMinutes       Int
  cookMinutes       Int
  difficulty        String
  cuisine           String?
  publishedAt       DateTime?
  translations      RecipeTranslation[]
  ingredients       RecipeIngredient[]
  steps             RecipeStep[]
  images            RecipeImage[]
  categories        RecipeCategory[]
  comments          Comment[]
  ratings           Rating[]
  favorites         Favorite[]
  collectionRecipes CollectionRecipe[]
  reports           Report[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model RecipeTranslation {
  id             String @id @default(cuid())
  recipeId       String
  recipe         Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  locale         Locale
  title          String
  description    String
  cuisine        String?
  seoTitle       String?
  seoDescription String?
  tips           String?
  storage        String?

  @@unique([recipeId, locale])
  @@index([locale, title])
}

model RecipeStep {
  id          String @id @default(cuid())
  recipeId    String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  locale      Locale
  position    Int
  instruction String
  imageUrl    String?

  @@unique([recipeId, locale, position])
}

model Ingredient {
  id           String                  @id @default(cuid())
  canonicalKey String                  @unique
  translations IngredientTranslation[]
  recipes      RecipeIngredient[]
  createdAt    DateTime                @default(now())
}

model IngredientTranslation {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  locale       Locale
  name         String
  aliases      String[]

  @@unique([ingredientId, locale])
  @@index([locale, name])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  amount       Decimal?   @db.Decimal(10, 3)
  unit         String?
  note         String?
  position     Int

  @@unique([recipeId, position])
  @@index([ingredientId])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  translations CategoryTranslation[]
  recipes      RecipeCategory[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?

  @@unique([categoryId, locale])
}

model RecipeCategory {
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  categoryId String
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model RecipeImage {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url      String
  alt      String?
  position Int

  @@unique([recipeId, position])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
}

model Collection {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  recipes   CollectionRecipe[]
  createdAt DateTime           @default(now())

  @@unique([userId, name])
}

model CollectionRecipe {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, recipeId])
}

model Comment {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([recipeId, approved])
}

model Rating {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
}

model Report {
  id         String    @id @default(cuid())
  recipeId   String?
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  reason     String
  details    String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
